}
abstract class DAO {
  #con : Connection
  --
  #DAO()
  ' Additional implementation members from DAO.java.
  ' #ownsConnection : boolean
  ' +close() : void
}
together {
class DocumentDAO {
  ' SQL query constant SELECT is declared in Java.
  +DocumentDAO()
  +searchByTitle(keyword : String) : List<Document1>
  +getDocumentDetail(documentCode : String) : Document1
}
class DocumentCopyDAO {
  +DocumentCopyDAO()
  +countAvailableByDocument(documentCode : String) : int
}
}
class DocumentType1 {
  -id : int
  -typeCode : String
  -typeName : String
  -description : String
  -documents : List<Document1>
}
class Document1 {
  -id : int
  -documentCode : String
  -title : String
  -author : String
  -publisher : String
  -publicationYear : int
  -description : String
  -shelfLocation : String
  -coverImage : String
  -documentType : DocumentType1
  -copies : List<DocumentCopy1>
}
class DocumentCopy1 {
  -id : int
  -barcode : String
  -loanStatus : String
  -physicalCondition : String
  -document : Document1
  ' Operations for cross-checking against the sequence and JSP or Java source.
  ' +checkBorrowable() : boolean
  ' +getAvailability() : boolean
}
' Solid working associations follow textbook Figure 4.4.

Home -right- Search
Search -right- Detail
Search -- DocumentDAO
Detail -- DocumentDAO
Detail -- DocumentCopyDAO
DocumentDAO -left-|> DAO
DocumentCopyDAO -left-|> DAO
DocumentDAO -- Document1
DocumentDAO -- DocumentType1
DocumentCopyDAO -- DocumentCopy1

' Exclusive copy ownership is inherited from the supplied entity diagram.
DocumentType1 "1" o-right- "0..*" Document1
Document1 "1" *-right- "0..*" DocumentCopy1

' Layout-only constraints; they never appear as business relationships.
DocumentDAO -[hidden]right- DocumentCopyDAO

caption Biểu đồ lớp thiết kế mô-đun tra cứu tài liệu
@enduml
